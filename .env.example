# Copy to .env.local and fill in. Never commit .env.local.

# First owner account for /admin. Created (password hashed) on first sign-in;
# after that you can delete ADMIN_PASSWORD from this file and manage passwords in Admin > My account.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 64 random hex characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Public address of the shop, used in links inside WhatsApp alerts
SITE_URL=https://your-domain.example

# Online database (Supabase). Without it, orders are kept in .data/ on this computer.
# Supabase › your project › Connect › "Transaction pooler" connection string, with your database password in it.
DATABASE_URL=

# Order alerts on your phone through a Telegram bot (free; separate from WhatsApp). See README.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp order alerts: none | wapilot | cloud | callmebot
WHATSAPP_PROVIDER=none
# wapilot = WaPilot (app.wapilot.net): API token from your account, and the instance unique name
#   (the instance is the WhatsApp number that SENDS the alert)
WAPILOT_TOKEN=
WAPILOT_INSTANCE_ID=
# cloud = Meta WhatsApp Cloud API (business account, permanent access token, phone number ID)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# optional approved template name (needed to message you outside a 24-hour chat window)
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
# callmebot = free personal alerts to your own number (get a key at callmebot.com)
CALLMEBOT_API_KEY=
